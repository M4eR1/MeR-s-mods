RegisterUser:
    Gui, Submit

    if (GuiUsername = "" || GuiKey = "") {
        MsgBox, 48, Missing Info, Fill all fields.
        Return
    }

    ; Optional: minimum username length
    if (StrLen(GuiUsername) < 3) {
        MsgBox, 48, Invalid Username, Username must be at least 3 characters.
        return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiKey, ActiveKeyExpires)

    if (status != "valid") {
        MsgBox, 48, Invalid Key, Invalid or expired key.
        SendWebhook("Invalid registration attempt", GuiUsername, GuiKey, "DENIED")
        Return
    }

    username   := GuiUsername
    licenseKey := GuiKey

    ; Bind key to IP
    if (CheckKeyOwnership(licenseKey) != "ok")
        Return

    ; Save to config
    IniWrite, 1,            %ConfigFile%, User, Registered
    IniWrite, %username%,   %ConfigFile%, User, Username
    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey

    ; Save username + expiration to UsedKeysFile (for admin panel)
    IniWrite, %username%,         %UsedKeysFile%, %licenseKey%, User
    IniWrite, %ActiveKeyExpires%, %UsedKeysFile%, %licenseKey%, Expire

    SendWebhook("New registration", username, licenseKey, "REGISTERED")

    Gui, Destroy
    Gosub, AfterLogin
Return

