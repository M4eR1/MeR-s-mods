SubmitNewKey:
    Gui, Submit

    if (GuiNewKey = "") {
        MsgBox, 48, Missing, Enter a key.
        Return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiNewKey, ActiveKeyExpires)

    if (status != "valid") {
        MsgBox, 48, Invalid Key, Key invalid or expired.
        SendWebhook("Invalid key renewal", username, GuiNewKey, "DENIED")
        Return
    }

    licenseKey := GuiNewKey

    if (CheckKeyOwnership(licenseKey) != "ok")
        Return

    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey
    IniWrite, %ActiveKeyExpires%, %UsedKeysFile%, %licenseKey%, Expire

    SendWebhook("Key renewed", username, licenseKey, "RENEWED")

    Gui, Destroy
    Gosub, AfterLogin
Return

; ==========================================================
; AFTER LOGIN → RUN MAIN SCRIPT
; Also update Last Login in UsedKeysFile
; ==========================================================
AfterLogin:
    global username, licenseKey, UsedKeysFile

    ; Store last login time for admin panel
    FormatTime, lastNow,, yyyy-MM-dd HH:mm:ss
    IniWrite, %lastNow%, %UsedKeysFile%, %licenseKey%, Last

    SendWebhook("Script launched", username, licenseKey, "ON")

    tempFile := A_Temp "\Bo7_remote.ahk"
    urlMain  := MainScriptURL . "?cache=" . A_TickCount
    UrlDownloadToFile, %urlMain%, %tempFile%

    if (ErrorLevel) {
        MsgBox, 16, Error, Failed to download main script.
        SendWebhook("Download failure", username, licenseKey, "ERROR")
        Return
    }

    Run, %tempFile%
Return

