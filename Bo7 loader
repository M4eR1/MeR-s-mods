global username, licenseKey, KeyDB, ActiveKeyExpires, NewKeyReason

; ==========================================================
; LOAD REMOTE KEYS (with forced cache reset)
; Keys file format on GitHub:
;   KEY|YYYYMMDD   (e.g. kj|20251118)
;   KEY|0          (lifetime)
; ==========================================================
LoadRemoteKeys() {
    global KeysURL, KeyDB
    KeyDB := []

    temp := A_Temp "\Bo7_keys_remote.txt"
    url  := KeysURL . "?cache=" . A_TickCount

    ; Always delete old file so new keys are loaded
    if FileExist(temp)
        FileDelete, %temp%

    UrlDownloadToFile, %url%, %temp%
    FileRead, contents, %temp%

    Loop, Parse, contents, `n, `r
    {
        line := Trim(A_LoopField)
        if (line = "")
            continue
        if (SubStr(line,1,1) = ";")
            continue

        StringSplit, part, line, |
        item := {}
        item.key     := Trim(part1)
        item.expires := Trim(part2)
        KeyDB.Push(item)
    }
}

; ==========================================================
; CHECK KEY STATUS (valid / expired / unknown)
; ==========================================================
GetKeyStatus(k, ByRef expOut) {
    global KeyDB
    expOut := ""
    today := SubStr(A_Now, 1, 8)

    for i, obj in KeyDB {
        if (obj.key = k) {
            expOut := obj.expires

            ; Lifetime key
            if (expOut = "" || expOut = "0")
                return "valid"

            ; Normal expiration (YYYYMMDD)
            if (today <= expOut)
                return "valid"

            return "expired"
        }
    }
    return "unknown"
}

; ==========================================================
; FETCH IP + GEO (used for IP binding + webhook)
; ==========================================================
FetchIPInfo(ByRef ip:="", ByRef country:="", ByRef city:="", ByRef org:="") {
    wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
    wh.Open("GET", "https://ipinfo.io/json", false)
    wh.Send()

    if (wh.Status != 200) {
        ip := ""
        country := ""
        city := ""
        org := ""
        return false
    }

    resp := wh.ResponseText

    RegExMatch(resp, """ip"":\s*""([^""]+)""", m1), ip := m11
    RegExMatch(resp, """country"":\s*""([^""]+)""", m2), country := m21
    RegExMatch(resp, """city"":\s*""([^""]+)""", m3), city := m31
    RegExMatch(resp, """org"":\s*""([^""]+)""", m4), org := m41

    return true
}

; ==========================================================
; KEY ↔ IP BINDING SYSTEM
; - First time key is used → bind to current IP
; - Next time → must be same IP
; - Username NOT used here at all (only stored for info)
; ==========================================================
CheckKeyOwnership(key) {
    global UsedKeysFile

    FetchIPInfo(ip)
    if (ip = "") {
        MsgBox, 16, Error, Failed to fetch IP. Check your internet.
        return "denied"
    }

    IniRead, StoredIP, %UsedKeysFile%, %key%, IP, NONE
    if (StoredIP = "NONE" or StoredIP = "")
    {
        ; First time this key is used → bind IP
        IniWrite, %ip%, %UsedKeysFile%, %key%, IP
        return "ok"
    }

    if (StoredIP = ip)
        return "ok"

    MsgBox, 48, Access Denied, This key is locked to IP:`n%StoredIP%
    return "denied"
}

; ==========================================================
; ACTIVE KEY SUMMARY (for dashboard embed)
; ==========================================================
GetActiveKeysSummary() {
    global licenseKey, ActiveKeyExpires

    if (licenseKey = "")
        return "No active key."

    if (ActiveKeyExpires = "" || ActiveKeyExpires = "0")
        expText := "Lifetime"
    else if (StrLen(ActiveKeyExpires) = 8)
        expText := SubStr(ActiveKeyExpires,1,4) "-" SubStr(ActiveKeyExpires,5,2) "-" SubStr(ActiveKeyExpires,7,2)
    else
        expText := ActiveKeyExpires

    return "Key: " licenseKey "`nExpires: " expText
}

; ==========================================================
; DISCORD DASHBOARD WEBHOOK
; Username is for info only here
; ==========================================================
SendWebhook(event, user, key, status := "") {
    global DashboardFile, WebhookURL

    if (WebhookURL = "")
        return

    RegExMatch(WebhookURL, "webhooks/(\d+)/([^/]+)", w)
    WH_ID := w1, WH_TOKEN := w2

    keys := GetActiveKeysSummary()
    StringReplace, keysEsc, keys, `n, \n, All

    ip := "", country := "", city := "", org := ""
    FetchIPInfo(ip, country, city, org)

    ipBlock := "IP: " ip "\nCountry: " country "\nCity: " city "\nISP: " org
    StringReplace, ipEsc, ipBlock, `n, \n, All

    FormatTime, tsUTC,, yyyy-MM-dd HH:mm:ss
    FormatTime, localNow,, HH:mm
    lastText := "Today at " localNow

    StringUpper, statusUpper, status

    if (statusUpper = "REGISTERED" || statusUpper = "RENEWED" || statusUpper = "ON" || statusUpper = "OFF")
        embedColor := "5763719"
    else if (statusUpper = "WARNING")
        embedColor := "16776960"
    else if (statusUpper = "DENIED" || statusUpper = "ERROR")
        embedColor := "15548997"
    else
        embedColor := "3447003"

    embed =
    (
{
  "embeds":[
    {
      "title":"MER BO7 LOADER DASHBOARD",
      "color":__COLOR__,
      "fields":[
        { "name":"User",        "value":"__USER__",   "inline":true },
        { "name":"Key",         "value":"__KEY__",    "inline":true },
        { "name":"Status",      "value":"__STATUS__", "inline":true },
        { "name":"Event",       "value":"__EVENT__",  "inline":true },
        { "name":"Last Online", "value":"__LAST__",   "inline":false },
        { "name":"IP Details",  "value":"__IP__",     "inline":false },
        { "name":"Active Keys", "value":"__KEYS__",   "inline":false }
      ],
      "footer":{ "text":"Updated: __TS__ UTC" },
      "timestamp":"__TS__Z"
    }
  ]
}
    )

    StringReplace, embed, embed, __COLOR__,  %embedColor%, All
    StringReplace, embed, embed, __USER__,   %user%,      All
    StringReplace, embed, embed, __KEY__,    %key%,       All
    StringReplace, embed, embed, __STATUS__, %status%,    All
    StringReplace, embed, embed, __EVENT__,  %event%,     All
    StringReplace, embed, embed, __LAST__,   %lastText%,  All
    StringReplace, embed, embed, __IP__,     %ipEsc%,     All
    StringReplace, embed, embed, __KEYS__,   %keysEsc%,   All
    StringReplace, embed, embed, __TS__,     %tsUTC%,     All

    url := "https://discord.com/api/webhooks/" WH_ID "/" WH_TOKEN

    wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
    wh.Open("POST", url, false)
    wh.SetRequestHeader("Content-Type","application/json")
    wh.Send(embed)
}

; ==========================================================
; EXIT HANDLER
; ==========================================================
OnScriptExit(reason, code) {
    global username, licenseKey
    SendWebhook("Script Exit", username, licenseKey, "OFF")
}

; ==========================================================
; STARTUP LOGIC
; ==========================================================
if !FileExist(ConfigDir)
    FileCreateDir, %ConfigDir%

if !FileExist(UsedKeysFile)
    FileAppend,, %UsedKeysFile%

OnExit("OnScriptExit")

LoadRemoteKeys()

IniRead, Registered, %ConfigFile%, User, Registered, 0
IniRead, SavedUser,  %ConfigFile%, User, Username,
IniRead, SavedKey,   %ConfigFile%, User, LicenseKey,

if (Registered != 1 || SavedUser = "" || SavedKey = "") {
    Gosub, ShowRegisterGui
} else {
    username   := SavedUser
    licenseKey := SavedKey

    status := GetKeyStatus(licenseKey, ActiveKeyExpires)
    if (status = "valid") {
        if (CheckKeyOwnership(licenseKey) = "ok")
            Gosub, AfterLogin
    } else {
        NewKeyReason := (status = "expired") ? "expired" : "invalid"
        Gosub, ShowNewKeyGui
    }
}
Return

