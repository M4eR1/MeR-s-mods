; ==========================================================
; MeR Bo7 Loader — Username-Bound Licensing (AHK v1 Clean)
; Now includes: *Key Refresh Fix* (Deletes old key file before downloading new ones)
; ==========================================================

#NoEnv
#SingleInstance, Force
#Persistent
#NoTrayIcon
SetBatchLines, -1

; ---------------- SETTINGS ----------------
WebhookURL    := "https://discord.com/api/webhooks/1439780147606847651/TwUrdBrJJ68SAaqvRfxv8nn0q86wK77_HVD52mr42JyM7MisBottKawyMnq-MM5Nz2us"
MainScriptURL := "https://raw.githubusercontent.com/M4eR1/MeR-s-mods/refs/heads/mods/Bo7"
KeysURL       := "https://raw.githubusercontent.com/M4eR1/MeR-s-mods/refs/heads/mods/Keys%20Bo7"

ConfigDir     := A_AppData "\MeR_Bo7"
ConfigFile    := ConfigDir "\config.ini"
UsedKeysFile  := ConfigDir "\used_keys.ini"
DashboardFile := ConfigDir "\dashboard_id.txt"

global username, licenseKey, KeyDB, ActiveKeyExpires, NewKeyReason

; ==========================================================
; USERNAME VALIDATION
; ==========================================================
ValidateUsername(name) {
    if (StrLen(name) < 3)
        return "short"

    StringLower, lower, name
    return lower
}

; ==========================================================
; LOAD REMOTE KEYS — WITH CACHE DELETE FIX
; ==========================================================
LoadRemoteKeys() {
    global KeysURL, KeyDB
    KeyDB := []

    temp := A_Temp "\Bo7_keys_remote.txt"
    url  := KeysURL . "?cache=" . A_TickCount

    ; --- FIX: ALWAYS DELETE OLD KEY FILE ---
    if FileExist(temp)
        FileDelete, %temp%

    ; Download new keys every time
    UrlDownloadToFile, %url%, %temp%

    FileRead, contents, %temp%

    Loop, Parse, contents, `n, `r
    {
        line := Trim(A_LoopField)
        if (line = "")
            continue
        if (SubStr(line,1,1) = ";")
            continue

        StringSplit, part, line, |
        item := {}
        item.key := Trim(part1)
        item.expires := Trim(part2)
        KeyDB.Push(item)
    }
}

; ==========================================================
; CHECK KEY STATUS
; ==========================================================
GetKeyStatus(k, ByRef out := "") {
    global KeyDB
    out := ""
    today := SubStr(A_Now, 1, 8)

    for i, obj in KeyDB {
        if (obj.key = k) {
            out := obj.expires
            if (out = "" || out = "0" || today <= out)
                return "valid"
            return "expired"
        }
    }
    return "unknown"
}

; ==========================================================
; KEY ↔ USERNAME BINDING
; ==========================================================
CheckKeyOwnership(key, username) {
    global UsedKeysFile

    StringLower, LowerUser, username

    IniRead, StoredUser,  %UsedKeysFile%, %key%, User,
    IniRead, StoredLower, %UsedKeysFile%, %key%, LowerUser,
    IniRead, UserExists,  %UsedKeysFile%, USER_LIST, %LowerUser%, 0

    ; First time activation
    if (StoredUser = "") {
        if (UserExists = 1) {
            MsgBox, 48, Username Taken, This username is already used by another user.
            return "denied"
        }

        IniWrite, %username%,  %UsedKeysFile%, %key%, User
        IniWrite, %LowerUser%, %UsedKeysFile%, %key%, LowerUser
        IniWrite, 1,           %UsedKeysFile%, USER_LIST, %LowerUser%
        return "ok"
    }

    ; Already bound → check owner
    StringLower, StoredLowerFix, StoredLower

    if (StoredLowerFix = LowerUser)
        return "ok"

    MsgBox, 48, Locked, This key belongs to:`n%StoredUser%.
    return "denied"
}

; ==========================================================
; IP LOOKUP
; ==========================================================
FetchIPInfo(ByRef ip:="", ByRef country:="", ByRef city:="", ByRef org:="") {
    wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
    wh.Open("GET", "https://ipinfo.io/json", false)
    wh.Send()

    resp := wh.ResponseText
    RegExMatch(resp, """ip"":\s*""([^""]+)""", m1), ip := m11
    RegExMatch(resp, """country"":\s*""([^""]+)""", m2), country := m21
    RegExMatch(resp, """city"":\s*""([^""]+)""", m3), city := m31
    RegExMatch(resp, """org"":\s*""([^""]+)""", m4), org := m41
}

; ==========================================================
; ACTIVE KEY SUMMARY
; ==========================================================
GetActiveKeysSummary() {
    global licenseKey, ActiveKeyExpires

    if (licenseKey = "")
        return "None"

    if (ActiveKeyExpires = "" or ActiveKeyExpires = "0")
        exp := "Lifetime"
    else if (StrLen(ActiveKeyExpires) = 8)
        exp := SubStr(ActiveKeyExpires,1,4) "-" SubStr(ActiveKeyExpires,5,2) "-" SubStr(ActiveKeyExpires,7,2)
    else
        exp := ActiveKeyExpires

    return "Key: " licenseKey "`nExpires: " exp
}

; ==========================================================
; WEBHOOK SYSTEM
; ==========================================================
SendWebhook(event, user, key, status := "") {
    global DashboardFile, WebhookURL

    RegExMatch(WebhookURL, "webhooks/(\d+)/([^/]+)", w)
    WH_ID := w1, WH_TOKEN := w2

    keys := GetActiveKeysSummary()
    StringReplace, keysEsc, keys, `n, \n, All

    ip := "", country := "", city := "", org := ""
    FetchIPInfo(ip, country, city, org)

    block := "IP: " ip "\nCountry: " country "\nCity: " city "\nISP: " org
    StringReplace, blockEsc, block, `n, \n, All

    FormatTime, t1,, yyyy-MM-dd HH:mm:ss
    FormatTime, t2,, HH:mm
    StringUpper, STAT, status

    embedColor := (STAT = "DENIED" or STAT = "ERROR") ? "15548997"
                : (STAT = "WARNING") ? "16776960"
                : "5763719"

    embed =
    (
{
 "embeds":[
  {
   "title":"MER BO7 LOADER DASHBOARD",
   "color":__COLOR__,
   "fields":[
     {"name":"User","value":"__USER__","inline":true},
     {"name":"Key","value":"__KEY__","inline":true},
     {"name":"Status","value":"__STATUS__","inline":true},
     {"name":"Event","value":"__EVENT__","inline":true},
     {"name":"Last Online","value":"__LAST__","inline":false},
     {"name":"IP Details","value":"__IP__","inline":false},
     {"name":"Active Keys","value":"__KEYS__","inline":false}
   ],
   "footer":{"text":"Updated: __TS__ UTC"},
   "timestamp":"__TS__Z"
  }
 ]
}
    )

    StringReplace, embed, embed, __COLOR__, %embedColor%, All
    StringReplace, embed, embed, __USER__, %user%, All
    StringReplace, embed, embed, __KEY__, %key%, All
    StringReplace, embed, embed, __STATUS__, %status%, All
    StringReplace, embed, embed, __EVENT__, %event%, All
    StringReplace, embed, embed, __LAST__, %t2%, All
    StringReplace, embed, embed, __IP__, %blockEsc%, All
    StringReplace, embed, embed, __KEYS__, %keysEsc%, All
    StringReplace, embed, embed, __TS__, %t1%, All

    url := "https://discord.com/api/webhooks/" WH_ID "/" WH_TOKEN

    wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
    wh.Open("POST", url, false)
    wh.SetRequestHeader("Content-Type","application/json")
    wh.Send(embed)
}

; ==========================================================
; EXIT HANDLER
; ==========================================================
OnScriptExit(reason, code) {
    global username, licenseKey
    SendWebhook("Script Exit", username, licenseKey, "OFF")
}

; ==========================================================
; STARTUP
; ==========================================================
if !FileExist(ConfigDir)
    FileCreateDir, %ConfigDir%

if !FileExist(UsedKeysFile)
    FileAppend,, %UsedKeysFile%

OnExit("OnScriptExit")
LoadRemoteKeys()

IniRead, Registered, %ConfigFile%, User, Registered, 0
IniRead, SavedUser,  %ConfigFile%, User, Username,
IniRead, SavedKey,   %ConfigFile%, User, LicenseKey,

if (Registered != 1 or SavedUser = "") {
    Gosub, ShowRegisterGui
} else {
    username   := SavedUser
    licenseKey := SavedKey

    status := GetKeyStatus(licenseKey, ActiveKeyExpires)

    if (status = "valid") {
        if (CheckKeyOwnership(licenseKey, username) = "ok")
            Gosub, AfterLogin
    } else {
        NewKeyReason := (status = "expired") ? "expired" : "invalid"
        Gosub, ShowNewKeyGui
    }
}
Return

; ==========================================================
; REGISTRATION GUI
; ==========================================================
ShowRegisterGui:
    Gui, New, +AlwaysOnTop -SysMenu +ToolWindow, MeR Loader
    Gui, Color, 111111
    Gui, Font, s10 cFFA500

    Gui, Add, Text, x0 y10 w280 Center cFFA500, MeR's Bo7 Loader
    Gui, Add, Text, x0 y40 w280 Center cFFFFFF, Create Your Account

    Gui, Add, Text, x10 y80  cFFA500, Username:
    Gui, Add, Edit, x10 y100 w260 vGuiUsername

    Gui, Add, Text, x10 y140 cFFA500, License Key:
    Gui, Add, Edit, x10 y160 w260 vGuiKey Password

    Gui, Add, Button, x10  y210 w120 h30 gRegisterUser, Register
    Gui, Add, Button, x150 y210 w120 h30 gExitAppBtn, Exit
    Gui, Show
Return

RegisterUser:
    Gui, Submit

    if (GuiUsername = "" or GuiKey = "") {
        MsgBox, 48, Missing Info, Fill in all fields.
        Return
    }

    lower := ValidateUsername(GuiUsername)
    if (lower = "short") {
        MsgBox, 48, Invalid Username, Username must be at least 3 characters.
        Return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiKey, ActiveKeyExpires)

    if (status != "valid") {
        MsgBox, 48, Invalid Key, Invalid or expired.
        Return
    }

    username   := GuiUsername
    licenseKey := GuiKey

    if (CheckKeyOwnership(licenseKey, username) != "ok")
        Return

    IniWrite, 1,            %ConfigFile%, User, Registered
    IniWrite, %username%,   %ConfigFile%, User, Username
    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey

    Gui, Destroy
    Gosub, AfterLogin
Return

; ==========================================================
; NEW KEY GUI
; ==========================================================
ShowNewKeyGui:
    Gui, New, +AlwaysOnTop -SysMenu +ToolWindow, Key Needed
    Gui, Color, 111111
    Gui, Font, s10 cFFA500

    txt := (NewKeyReason = "expired") ? "Your key has expired." : "Your key is invalid."
    Gui, Add, Text, x0 y20 w280 Center cFFA500, %txt%
    Gui, Add, Text, x0 y50 w280 Center cFFFFFF, Enter new key:

    Gui, Add, Edit, x10 y90 w260 vGuiNewKey Password
    Gui, Add, Button, x10  y130 w120 h30 gSubmitNewKey, Activate
    Gui, Add, Button, x150 y130 w120 h30 gExitAppBtn, Exit
    Gui, Show
Return

SubmitNewKey:
    Gui, Submit
    if (GuiNewKey = "") {
        MsgBox, 48, Missing, Enter a key.
        Return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiNewKey, ActiveKeyExpires)

    if (status != "valid") {
        MsgBox, 48, Invalid Key, Still invalid or expired.
        Return
    }

    licenseKey := GuiNewKey

    if (CheckKeyOwnership(licenseKey, username) != "ok")
        Return

    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey

    Gui, Destroy
    Gosub, AfterLogin
Return

; ==========================================================
; AFTER LOGIN
; ==========================================================
AfterLogin:
    SendWebhook("Script launched", username, licenseKey, "ON")

    temp := A_Temp "\Bo7_remote.ahk"
    urlMain := MainScriptURL . "?cache=" . A_TickCount

    UrlDownloadToFile, %urlMain%, %temp%
    Run, %temp%
Return

; ==========================================================
; EXIT BUTTON
; ==========================================================
ExitAppBtn:
    ExitApp
Return
