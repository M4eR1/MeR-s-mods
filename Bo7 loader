; ==========================================================
; MeR Bo7 Loader — Full Final Version (FIXED)
; ==========================================================

#NoEnv
#SingleInstance, Force
#Persistent
#NoTrayIcon
SetBatchLines, -1

; ---------------- SETTINGS ----------------
WebhookURL := "https://discord.com/api/webhooks/1439780147606847651/TwUrdBrJJ68SAaqvRfxv8nn0q86wK77_HVD52mr42JyM7MisBottKawyMnq-MM5Nz2us"
MainScriptURL := "https://raw.githubusercontent.com/M4eR1/MeR-s-mods/refs/heads/mods/Bo7"
KeysURL := "https://raw.githubusercontent.com/M4eR1/MeR-s-mods/refs/heads/mods/Keys%20Bo7"

ConfigDir   := A_AppData "\MeR_Bo7"
ConfigFile  := ConfigDir "\config.ini"
KeyLockFile := ConfigDir "\keys_lock.ini"
DashboardFile := ConfigDir "\dashboard_id.txt"

global username, licenseKey, KeyDB, ActiveKeyExpires, NewKeyReason

; ==========================================================
; FUNCTIONS
; ==========================================================

GetHWID() {
    RunWait, %ComSpec% /c wmic useraccount where name="%USERNAME%" get sid > "%A_Temp%\sid.txt",, Hide
    FileRead, sid, %A_Temp%\sid.txt
    return Trim(StrReplace(sid, "SID"))
}

LoadRemoteKeys() {
    global KeysURL, KeyDB
    KeyDB := []

    temp := A_Temp "\Bo7_keys_remote.txt"
    UrlDownloadToFile, %KeysURL% "?cache=" A_TickCount, %temp%

    FileRead, contents, %temp%
    Loop, Parse, contents, `n, `r {
        line := Trim(A_LoopField)
        if (line = "" || SubStr(line,1,1) = ";")
            continue
        StringSplit, part, line, |
        KeyDB.Push({ key: Trim(part1), expires: Trim(part2) })
    }
}

GetKeyStatus(thisKey, ByRef expOut := "") {
    global KeyDB
    today := SubStr(A_Now,1,8)

    for i, k in KeyDB {
        if (k.key = thisKey) {
            expOut := k.expires
            if (expOut = "" || expOut = "0" || today <= expOut)
                return "valid"
            return "expired"
        }
    }
    return "unknown"
}

CheckKeyOwnership(key, username) {
    global KeyLockFile
    hwid := GetHWID()

    IniRead, savedHWID, %KeyLockFile%, %key%, UsedByHWID,
    IniRead, savedUser, %KeyLockFile%, %key%, UsedByUser,

    if (savedHWID = "" && savedUser = "") {
        IniWrite, %hwid%,    %KeyLockFile%, %key%, UsedByHWID
        IniWrite, %username%, %KeyLockFile%, %key%, UsedByUser
        return "ok"
    }

    if (savedHWID = hwid)
        return "ok"

    SendWebhook("Key used on another device", username, key, "WARNING")
    MsgBox, 48, Key In Use, This key is already used on another PC.
    return "denied"
}

GetActiveKeysSummary() {
    global KeyDB
    out := ""
    for i, k in KeyDB {
        exp := (k.expires = "" || k.expires = "0") ? "lifetime" : k.expires
        out .= k.key " (exp: " exp ")\n"
    }
    return out
}


; ==========================================================
; WEBHOOK (FIXED VERSION — PLACEHOLDERS)
; ==========================================================

SendWebhook(event, user, key, status := "", owner := "", oldhwid := "", newhwid := "") {
    global WebhookURL, DashboardFile

    RegExMatch(WebhookURL, "webhooks/(\d+)/([^/]+)", w)
    WH_ID := w1, WH_TOKEN := w2

    hwid := GetHWID()
    keys := GetActiveKeysSummary()
    StringReplace, keysEsc, keys, `n, \n, All
    FormatTime, ts,, yyyy-MM-dd HH:mm:ss

    ; ----- JSON TEMPLATE -----
    embed =
    (
{
  "embeds": [
    {
      "title": "🟧🔥 M E R — B O 7  L O A D E R 🔥🟧",
      "color": 16753920,
      "fields": [
        { "name": "👤 USER",   "value": "__USER__",   "inline": true },
        { "name": "🔑 KEY",    "value": "__KEY__",    "inline": true },
        { "name": "💻 HWID",   "value": "__HWID__",   "inline": false },
        { "name": "📊 STATUS", "value": "__STATUS__", "inline": true },
        { "name": "🧩 EVENT",  "value": "__EVENT__",  "inline": true },
        { "name": "🟠 ACTIVE KEYS", "value": "__KEYS__", "inline": false }
      ],
      "footer": { "text": "Updated: __TS__ UTC" },
      "timestamp": "__TS__Z"
    }
  ]
}
    )

    ; ----- Replace placeholders -----
    replUser := "**" user "**"
    replStatus := "**" status "**"
    replEvent := "**" event "**"

    StringReplace, embed, embed, __USER__,   %replUser%,   All
    StringReplace, embed, embed, __KEY__,    %key%,        All
    StringReplace, embed, embed, __HWID__,   %hwid%,       All
    StringReplace, embed, embed, __STATUS__, %replStatus%, All
    StringReplace, embed, embed, __EVENT__,  %replEvent%,  All
    StringReplace, embed, embed, __KEYS__,   %keysEsc%,    All
    StringReplace, embed, embed, __TS__,     %ts%,         All

    ; ----- PATCH or POST -----
    if FileExist(DashboardFile) {
        FileRead, msgid, %DashboardFile%
        msgid := Trim(msgid)
        if (msgid != "") {
            url := "https://discord.com/api/webhooks/" WH_ID "/" WH_TOKEN "/messages/" msgid
            wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
            wh.Open("PATCH", url, false)
            wh.SetRequestHeader("Content-Type","application/json")
            wh.Send(embed)
            if (wh.Status = 200)
                return
        }
    }

    url := "https://discord.com/api/webhooks/" WH_ID "/" WH_TOKEN
    wh := ComObjCreate("WinHttp.WinHttpRequest.5.1")
    wh.Open("POST", url, false)
    wh.SetRequestHeader("Content-Type","application/json")
    wh.Send(embed)

    resp := wh.ResponseText
    RegExMatch(resp, """id"":""([^""]+)""", m)
    if (m1 != "") {
        FileDelete, %DashboardFile%
        FileAppend, %m1%, %DashboardFile%
    }
}


OnScriptExit(reason, code) {
    global username, licenseKey
    SendWebhook("Loader exit", username, licenseKey, "OFF")
}


; ==========================================================
; STARTUP
; ==========================================================

if !FileExist(ConfigDir)
    FileCreateDir, %ConfigDir%

OnExit("OnScriptExit")
LoadRemoteKeys()

IniRead, Registered, %ConfigFile%, User, Registered, 0
IniRead, SavedUser, %ConfigFile%, User, Username,
IniRead, SavedKey,  %ConfigFile%, User, LicenseKey,

if (Registered != 1 || SavedUser = "") {
    Gosub, ShowRegisterGui
} else {
    username := SavedUser
    licenseKey := SavedKey
    status := GetKeyStatus(licenseKey, ActiveKeyExpires)

    if (status = "valid") {
        if (CheckKeyOwnership(licenseKey, username) = "ok")
            Gosub, AfterLogin
    } else {
        NewKeyReason := (status = "expired") ? "expired" : "invalid"
        Gosub, ShowNewKeyGui
    }
}
Return


; ==========================================================
; GUIS
; ==========================================================

ShowRegisterGui:
    Gui, New, +AlwaysOnTop, MeR Loader
    Gui, Color, 111111
    Gui, Font, s10 cFFA500

    Gui, Add, Text, x0 y10 w280 Center cFFA500, MeR's Bo7 Loader
    Gui, Add, Text, x0 y40 w280 Center cFFFFFF, Create your account

    Gui, Add, Text, x10 y80 cFFA500, Username:
    Gui, Add, Edit, x10 y100 w260 vGuiUsername

    Gui, Add, Text, x10 y140 cFFA500, License Key:
    Gui, Add, Edit, x10 y160 w260 vGuiKey Password

    Gui, Add, Button, x10 y210 w120 h30 gRegisterUser, Register
    Gui, Add, Button, x150 y210 w120 h30 gExitAppBtn, Exit
    Gui, Show
Return

RegisterUser:
    Gui, Submit
    if (GuiUsername="" || GuiKey="") {
        MsgBox, 48, Missing, Fill all fields.
        Return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiKey, ActiveKeyExpires)
    if (status != "valid") {
        MsgBox, 48, Invalid, Invalid or expired key.
        SendWebhook("Invalid registration key", GuiUsername, GuiKey, "DENIED")
        Return
    }

    username := GuiUsername
    licenseKey := GuiKey

    if (CheckKeyOwnership(licenseKey, username) != "ok")
        Return

    IniWrite, 1,            %ConfigFile%, User, Registered
    IniWrite, %username%,   %ConfigFile%, User, Username
    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey

    SendWebhook("New registration", username, licenseKey, "REGISTERED")

    Gui, Destroy
    Gosub, AfterLogin
Return


ShowNewKeyGui:
    Gui, New, +AlwaysOnTop, Key Required
    Gui, Color, 111111
    Gui, Font, s10 cFFA500

    t := (NewKeyReason="expired") ? "Your key expired." : "Invalid key."
    Gui, Add, Text, x0 y20 w280 Center cFFA500, %t%
    Gui, Add, Text, x0 y50 w280 Center cFFFFFF, Enter new key

    Gui, Add, Edit, x10 y90 w260 vGuiNewKey Password
    Gui, Add, Button, x10 y130 w120 h30 gSubmitNewKey, Activate
    Gui, Add, Button, x150 y130 w120 h30 gExitAppBtn, Exit
    Gui, Show
Return

SubmitNewKey:
    Gui, Submit
    if (GuiNewKey = "") {
        MsgBox, 48, Missing, Enter a key.
        Return
    }

    LoadRemoteKeys()
    status := GetKeyStatus(GuiNewKey, ActiveKeyExpires)
    if (status != "valid") {
        MsgBox, 48, Invalid, Invalid or expired key.
        SendWebhook("Invalid renewal key", username, GuiNewKey, "DENIED")
        Return
    }

    licenseKey := GuiNewKey
    if (CheckKeyOwnership(licenseKey, username) != "ok")
        Return

    IniWrite, %licenseKey%, %ConfigFile%, User, LicenseKey
    SendWebhook("Key renewed", username, licenseKey, "RENEWED")

    Gui, Destroy
    Gosub, AfterLogin
Return


; ==========================================================
; AFTER LOGIN — DOWNLOAD MAIN SCRIPT
; ==========================================================

AfterLogin:
    SendWebhook("Script started", username, licenseKey, "ON")

    tempFile := A_Temp "\Bo7_remote.ahk"
    UrlDownloadToFile, %MainScriptURL% "?cache=" A_TickCount, %tempFile%

    if (ErrorLevel) {
        MsgBox, 16, Error, Failed to download script.
        SendWebhook("Download failed", username, licenseKey, "ERROR")
        Return
    }

    Run, %tempFile%
Return


; ==========================================================
; EXIT BUTTON
; ==========================================================
ExitAppBtn:
    ExitApp
Return
