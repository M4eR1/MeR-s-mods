AdminRefreshLV:
    global UsedKeysFile
    Gui, Admin:Default
    LV_Delete()

    ; Parse INI manually to list sections = keys
    currentSection := ""
    if !FileExist(UsedKeysFile)
        return

    Loop, Read, %UsedKeysFile%
    {
        line := Trim(A_LoopReadLine)
        if (line = "")
            continue

        ; Section line: [KeyName]
        if (SubStr(line,1,1) = "[" && SubStr(line,0) = "]") {
            currentSection := SubStr(line, 2, StrLen(line)-2)
            continue
        }

        ; Only process sections that look like keys (skip global stuff if any)
        if (currentSection = "")
            continue

        ; For each section, read once and add row (do it when we see first key)
        IniRead, IP,    %UsedKeysFile%, %currentSection%, IP,
        IniRead, User,  %UsedKeysFile%, %currentSection%, User,
        IniRead, Exp,   %UsedKeysFile%, %currentSection%, Expire,
        IniRead, Last,  %UsedKeysFile%, %currentSection%, Last,

        ; Format expiration for display
        if (Exp = "" || Exp = "0")
            ExpText := "Lifetime"
        else if (StrLen(Exp) = 8)
            ExpText := SubStr(Exp,1,4) "-" SubStr(Exp,5,2) "-" SubStr(Exp,7,2)
        else
            ExpText := Exp

        if (User = "")
            User := "(unknown)"
        if (IP = "")
            IP := "(unbound)"

        ; Add row only if not already there
        ; (Prevent duplicates because Loop, Read hits section multiple times)
        row := LV_GetCount()
        already := false
        if (row > 0) {
            Loop, %row%
            {
                LV_GetText(tmpKey, A_Index, 1)
                if (tmpKey = currentSection) {
                    already := true
                    break
                }
            }
        }
        if (!already)
            LV_Add("", currentSection, IP, User, ExpText, Last)
    }

    LV_ModifyCol()
return

AdminGetSelectedKey(ByRef outKey) {
    Gui, Admin:Default
    row := LV_GetNext(0, "F")
    if (!row) {
        MsgBox, 48, No Selection, Select a key first.
        outKey := ""
        return false
    }
    LV_GetText(k, row, 1)
    outKey := k
    return true
}

AdminUnlinkIP:
    global UsedKeysFile
    if (!AdminGetSelectedKey(key))
        return

    ; Remove IP only (keep user, expire, last)
    IniDelete, %UsedKeysFile%, %key%, IP
    MsgBox, 64, Unlinked, IP unlinked from key:`n%key%
    Gosub, AdminRefreshLV
return

AdminDeleteKey:
    global UsedKeysFile
    if (!AdminGetSelectedKey(key))
        return

    MsgBox, 49, Confirm Delete, Delete all data for key:`n%key% ?
    IfMsgBox, No
        return

    ; Delete entire section for this key
    IniDelete, %UsedKeysFile%, %key%
    MsgBox, 64, Deleted, Entry deleted for key:`n%key%
    Gosub, AdminRefreshLV
return

AdminClose:
    Gui, Admin:Destroy
return

